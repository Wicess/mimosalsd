# MIMOSALSD — environment. Copy to .env and fill in. Never commit .env.

# ── Database (Neon) ──────────────────────────────────────────────────────────
# This site's OWN database. It must never point at another site's.
DATABASE_URL=
# Direct (non-pooled) connection, for migrations and backups.
DIRECT_URL=

# ── Site ─────────────────────────────────────────────────────────────────────
# Builds every canonical URL, sitemap entry and share link. Live value:
# https://www.mimosalsd.com — with the www/apex decision matching the redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin ────────────────────────────────────────────────────────────────────
# Signs the admin session cookie and the visit collector's token. 40+ random chars.
ADMIN_SESSION_SECRET=
# Generated with: npm run admin:hash
ADMIN_PASSWORD_HASH=

# ── Images and files (Cloudflare R2) ─────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# The public hostname the bucket is served from; product and article images are
# written as https://<host>/<key>.
R2_PUBLIC_HOST=
NEXT_PUBLIC_R2_PUBLIC_HOST=

# ── Email (Brevo) ────────────────────────────────────────────────────────────
BREVO_API_KEY=
EMAIL_FROM=MIMOSALSD <sales@mimosalsd.com>

# ── Alerts (ntfy) ────────────────────────────────────────────────────────────
NTFY_URL=https://ntfy.sh
# TWO topics, split the way the app splits them:
#   ALERTS — chat and messages: live chat, the contact form, bulk enquiries. A
#            person is waiting, so this one should ring.
#   ORDERS — everything else: new orders, payment claims, sign-ups, low stock,
#            site errors, failed admin sign-ins, state-rule changes.
# Give each a long random suffix. An ntfy.sh topic is readable by anyone who knows
# its name, so the name IS the password.
NTFY_TOPIC_ORDERS=
NTFY_TOPIC_ALERTS=
# Optional. Public ntfy.sh topics publish without one; set it only for a reserved
# topic on a paid or self-hosted server.
NTFY_TOKEN=

# ── Search engines ───────────────────────────────────────────────────────────
# Its own key, generated for this domain, served at /indexnow-key.txt.
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Scheduled work ───────────────────────────────────────────────────────────
CRON_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Only if the product writer is used from the admin panel.
ANTHROPIC_API_KEY=
AGE_VERIFY_PROVIDER=
