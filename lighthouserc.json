{
  "//": "Budgets are split by how reliably each metric measures the APPLICATION rather than the machine. LCP, CLS, accessibility, SEO and best-practices were stable across repeated local runs and are hard errors. The performance score and TBT swung 89-96 and 150-270ms across four consecutive runs of the SAME page on a loaded host (cpuBenchmarkIndex 406), so they are warnings here and must be judged on a clean runner using the median of three.",
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/shop",
        "http://localhost:3000/product/mhrb-powder-100g",
        "http://localhost:3000/legality/texas",
        "http://localhost:3000/lab-results/am-2026-0388"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "categories:performance": ["warn", { "minScore": 0.95 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
