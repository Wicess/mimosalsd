{
  "name": "mimosalsd",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "compliance:scan": "tsx scripts/compliance-scan.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:coverage": "vitest run --coverage",
    "db:replay-check": "tsx scripts/check-migration-replay.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:migrate:http": "tsx scripts/db-migrate.ts",
    "r2:check": "tsx scripts/r2-check.ts",
    "admin:hash": "tsx scripts/admin-hash.ts",
    "admin:user": "tsx scripts/seed-admin.ts",
    "test:e2e:admin": "node tests/e2e/admin.mjs",
    "db:demo": "tsx scripts/seed-demo.ts",
    "test:e2e:fixes": "node tests/e2e/admin-fixes.mjs",
    "indexnow": "tsx scripts/indexnow.ts",
    "admin:bootstrap": "tsx scripts/admin-bootstrap.ts",
    "prebuild": "node scripts/clean-build.mjs",
    "predev": "node scripts/clean-build.mjs",
    "e2e:accounts": "tsx scripts/e2e-accounts.ts",
    "e2e:admin": "tsx scripts/e2e-accounts.ts create && node tests/e2e/admin.mjs && node tests/e2e/admin-fixes.mjs; tsx scripts/e2e-accounts.ts clean",
    "images:upload": "tsx scripts/upload-images.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^6.1.0",
    "clsx": "^2.1.1",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.5.5",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.9",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.62.1",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
